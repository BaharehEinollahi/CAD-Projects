# Yosys synthesis script for LUT2 mapping
# add your verilog files here like this: 


read_verilog  constant_rom.v
read_verilog  counter.v
read_verilog  counter2.v
read_verilog  hash_ct.v
read_verilog  hash_dp.v
read_verilog  hash_top.v
read_verilog  multiplier.v
read_verilog  register.v
read_verilog  rnd_generator_ct.v
read_verilog  rnd_generator_dp.v
read_verilog  rnd_generator_top.v
read_verilog  shift_register.v



hierarchy -check -top hash_top
synth -lut 2
write_verilog -v -norename -noattr -noexpr -nodec mapped_design.v
