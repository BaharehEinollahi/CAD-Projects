# Yosys synthesis script for LUT2 mapping
# add your verilog files here like this: 

read_verilog -sv base_gates.sv
read_verilog -sv base_modules.sv
read_verilog -sv build_f1.sv
read_verilog -sv build_m_rnd.sv
read_verilog -sv constant_rom.sv
read_verilog -sv counter.sv
read_verilog -sv hash_ct.sv
read_verilog -sv hash_dp.sv
read_verilog -sv hash_top.sv
read_verilog -sv modules.sv
read_verilog -sv multiplier.sv
read_verilog -sv register.sv
read_verilog -sv rnd_generator_ct.sv
read_verilog -sv rnd_generator_dp.sv
read_verilog -sv rnd_generator_top.sv
read_verilog -sv shift_register.sv



hierarchy -check -top hash_top
synth -lut 2
write_verilog -norename -noattr -noexpr -nodec mapped_design.sv
