# read_verilog modules.sv
# read_verilog multiplier.sv
# read_verilog register.sv
# read_verilog rnd_generator_ct.sv
# read_verilog rnd_generator_dp.sv
# read_verilog rnd_generator_top.sv
# read_verilog shift_register.sv



hierarchy -check -top hash_top
synth -lut 2
write_verilog -norename -noattr -noexpr -nodec mapped_design.v
